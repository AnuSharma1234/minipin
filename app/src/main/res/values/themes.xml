<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with Material Design 3 -->
    <style name="Base.Theme.Minipin" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>
        
        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</item>
        
        <!-- Tertiary Colors -->
        <item name="colorTertiary">@color/md_theme_light_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_light_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_light_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_light_onTertiaryContainer</item>
        
        <!-- Surface Colors -->
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>
        
        <!-- Error Color -->
        <item name="colorError">@color/error</item>
        
        <!-- Outline -->
        <item name="colorOutline">@color/md_theme_light_outline</item>
        
        <!-- Text Appearance -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Minipin.LabelSmall</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Minipin.LabelMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Minipin.BodySmall</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Minipin.BodyMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Minipin.BodyLarge</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Minipin.HeadlineSmall</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Minipin.HeadlineMedium</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Minipin.HeadlineLarge</item>
        
        <!-- Material Button Style -->
        <item name="materialButtonStyle">@style/Widget.Minipin.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Minipin.Button.Outlined</item>
    </style>

    <style name="Theme.Minipin" parent="Base.Theme.Minipin" />
    
    <!-- Custom Text Appearance Styles -->
    <style name="TextAppearance.Minipin.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/md_theme_light_onSurfaceVariant</item>
    </style>
    
    <style name="TextAppearance.Minipin.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/md_theme_light_onSurfaceVariant</item>
    </style>
    
    <style name="TextAppearance.Minipin.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/md_theme_light_onSurface</item>
    </style>
    
    <style name="TextAppearance.Minipin.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/md_theme_light_onSurface</item>
    </style>
    
    <style name="TextAppearance.Minipin.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/md_theme_light_onSurface</item>
    </style>
    
    <style name="TextAppearance.Minipin.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/md_theme_light_onSurface</item>
    </style>
    
    <style name="TextAppearance.Minipin.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/md_theme_light_onSurface</item>
    </style>
    
    <style name="TextAppearance.Minipin.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/md_theme_light_onSurface</item>
    </style>
    
    <!-- Custom Button Styles -->
    <style name="Widget.Minipin.Button" parent="Widget.Material3.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
    
    <style name="Widget.Minipin.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>